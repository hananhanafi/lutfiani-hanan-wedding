# WhatsApp Service Environment
# Copy this to .env and fill in values

# API key for authenticating requests from your Next.js app
API_KEY=5f444479ed34d40ad8663bc8645659d4e8fc7cbd71cfba7fa60bdaaf85387f38

# Port to run the service on
PORT=3001

# Webhook URL to notify your app of incoming messages (optional)
